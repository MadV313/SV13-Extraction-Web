{
  "name": "sv13-extraction-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "SV13 Extraction official site + Unity-backed Survivor Database, map, weather and HUD intelligence.",
  "scripts": {
    "build": "node tools/check-knowledge.mjs && node tools/build-site.mjs",
    "preview": "node tools/serve.mjs",
